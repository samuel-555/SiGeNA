<%@ page import="sigena.model.domain.Cargo" %>
<%!
    boolean temPermissaoCadastro(Cargo cargo, String funcionalidade) {
        if (cargo == null) {
            return false;
        }
        if (cargo == Cargo.GERENTE) {
            return true;
        }

        return switch (funcionalidade) {
            case "planos" -> cargo == Cargo.ZOOTECNISTA; // veterinário sem criação/edição de planos
            case "ocorrencias" -> cargo == Cargo.ZOOTECNISTA || cargo == Cargo.VETERINARIO || cargo == Cargo.TRATADOR;
            case "enriquecimento" -> cargo == Cargo.ZOOTECNISTA || cargo == Cargo.VETERINARIO;
            case "animais", "especies", "tratamentos" -> cargo == Cargo.VETERINARIO;
            case "relatorios" -> cargo == Cargo.VETERINARIO;
            case "visitantes" -> false; // somente gerente
            default -> false;
        };
    }
%>
